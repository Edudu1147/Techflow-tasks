digraph G {
  rankdir=LR; nodesep=0.6; ranksep=1.0;
  graph [fontname="Helvetica", pad=0.3];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];

  Tarefa [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF1FF">
    <tr><td border="1" sides="B"><b>Tarefa</b></td></tr>
    <tr><td align="left" balign="left">- id : int<br/>- titulo : str<br/>- descricao : str<br/>- status : Status<br/>- prioridade : Prioridade</td></tr>
  </table>>];

  Status [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#F4F5F7">
    <tr><td border="1" sides="B">«enumeration»<br/><b>Status</b></td></tr>
    <tr><td align="left" balign="left">A Fazer<br/>Em Progresso<br/>Concluído</td></tr>
  </table>>];

  Prioridade [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#F4F5F7">
    <tr><td border="1" sides="B">«enumeration»<br/><b>Prioridade</b></td></tr>
    <tr><td align="left" balign="left">Baixa<br/>Média<br/>Alta<br/>Crítica</td></tr>
  </table>>];

  TaskRepository [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF1FF">
    <tr><td border="1" sides="B"><b>TaskRepository</b></td></tr>
    <tr><td align="left" balign="left">- caminho : str</td></tr>
    <tr><td border="1" sides="T" align="left" balign="left">+ criar(dados) : Tarefa<br/>+ listar(prioridade) : List&lt;Tarefa&gt;<br/>+ obter(id) : Tarefa<br/>+ atualizar(id, dados) : Tarefa<br/>+ excluir(id) : bool<br/>+ metricas() : dict</td></tr>
  </table>>];

  Validador [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF1FF">
    <tr><td border="1" sides="B"><b>Validador</b><br/>(módulo validation)</td></tr>
    <tr><td align="left" balign="left">+ validar_tarefa(dados, parcial) : dict</td></tr>
  </table>>];

  ValidationError [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFF0EE">
    <tr><td><b>ValidationError</b><br/>«exception»</td></tr>
  </table>>];

  AppFlask [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF1FF">
    <tr><td border="1" sides="B"><b>AppFlask</b><br/>(create_app)</td></tr>
    <tr><td align="left" balign="left">+ GET /api/tarefas<br/>+ POST /api/tarefas<br/>+ PUT /api/tarefas/{id}<br/>+ DELETE /api/tarefas/{id}<br/>+ GET /api/metricas<br/>+ GET /</td></tr>
  </table>>];

  AppFlask -> TaskRepository [label="usa", arrowhead=vee, style=dashed];
  AppFlask -> Validador [label="usa", arrowhead=vee, style=dashed];
  Validador -> ValidationError [label="lança", arrowhead=vee, style=dashed];
  TaskRepository -> Tarefa [label="gerencia\n0..*", arrowhead=odiamond, dir=back, arrowtail=none, taillabel="1", headlabel=""];
  Tarefa -> Status [label="status", arrowhead=vee];
  Tarefa -> Prioridade [label="prioridade", arrowhead=vee];
}
